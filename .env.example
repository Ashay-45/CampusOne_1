# ==============================================================================
# CampusOne Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or server/.env) and populate with your environment values.
# NEVER commit real .env files with actual secrets to version control.
# ==============================================================================

# Server Network & Runtime Environment
PORT=5000
NODE_ENV=development  # development | test | staging | production

# Database Connectivity (MongoDB Atlas or local cluster)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusone?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/campusone

# JSON Web Token Cryptographic Secret (Minimum 32 random characters recommended)
JWT_SECRET=your_secure_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple staging/production domains)
# Example: http://localhost:5173,https://staging.campusone.edu,https://campusone.edu
CLIENT_URL=http://localhost:5173

# Admin Provisioning Secret (Required for creating teacher/admin accounts via public signup)
ADMIN_REGISTRATION_SECRET=your_admin_registration_passphrase_here

# Reverse Proxy Trust Configuration (Set to '1' or 'true' when deployed behind NGINX/Cloudflare)
TRUST_PROXY=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes in milliseconds
RATE_LIMIT_AUTH_MAX=20            # Maximum login/registration attempts per window
RATE_LIMIT_AI_MAX=30              # Maximum AI queries per window
RATE_LIMIT_GENERAL_MAX=200        # Maximum general API requests per window
