# ==============================================================================
# CampusOne Backend Server Environment Configuration Template
# ==============================================================================
PORT=5000
NODE_ENV=development  # development | test | staging | production

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://localhost:27017/campusone

# JWT Secret Key
JWT_SECRET=your_secure_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Admin Registration Authorization Secret
ADMIN_REGISTRATION_SECRET=your_admin_registration_passphrase_here

# Reverse Proxy Setting (Set to true or 1 behind Nginx/Cloudflare)
TRUST_PROXY=false

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_GENERAL_MAX=200
